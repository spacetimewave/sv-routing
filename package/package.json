{
  "name": "sv-routing",
  "version": "0.3.0-alpha.1",
  "author": "Spacetimeave",
  "license": "MIT",
  "description": "A declarative Svelte routing library",
  "scripts": {
    "build": "vite build",
    "publish": "vite build && npm publish --access=public",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('../README.md', './README.md')\"",
    "postpublish": "node -e \"require('fs').existsSync('./README.md') && require('fs').unlinkSync('./README.md')\""
  },
  "keywords": [
    "svelte routing",
    "svelte",
    "sveltejs",
    "route",
    "router",
    "routing"
  ],
  "repository": "spacetimewave/sv-routing",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./Link.svelte": "./dist/Link.svelte",
    "./Route.svelte": "./dist/Route.svelte",
    "./Router.svelte": "./dist/Router.svelte"
  },
  "svelte": "./dist/index.js",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "typescript": "~5.9.3",
    "svelte": "^5.0.0",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  }
}