{
  "extends": ["@tsconfig/svelte/tsconfig.json"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "types": ["svelte"],
    "skipLibCheck": true,
    "noEmit": true, // Compilation is handled by Vite (not tsc)
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}